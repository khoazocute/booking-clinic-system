# Copy thành .env rồi điền giá trị. KHÔNG commit file .env
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 32   (hoặc: python -c "import secrets; print(secrets.token_hex(32))")

# --- Bắt buộc ---
JWT_SECRET=
AI_INTERNAL_TOKEN=

# --- Production: đặt TRƯỚC lần chạy đầu tiên (MySQL chỉ đọc mật khẩu khi tạo volume mới) ---
MYSQL_ROOT_PASSWORD=
VECTOR_DB_PASSWORD=
# Tài khoản admin đầu tiên, chỉ được tạo khi database trống (mật khẩu >= 12 ký tự)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Domain thật, ví dụ https://clinic.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- VNPay sandbox (https://sandbox.vnpayment.vn) - chỉ backend đọc ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/return

# --- Email nhắc lịch (tuỳ chọn; không có thì chỉ nhắc trong app) ---
APP_BASE_URL=http://localhost:5173
MAIL_USERNAME=
MAIL_PASSWORD=

# --- AI ---
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Giới hạn chi phí: mỗi phút / mỗi bệnh nhân mỗi ngày / toàn hệ thống mỗi ngày (vượt thì dùng chế độ dự phòng miễn phí)
AI_CHAT_RATE_LIMIT_PER_MINUTE=10
AI_CHAT_DAILY_LIMIT_PER_USER=40
AI_CHAT_DAILY_LIMIT_GLOBAL=500
